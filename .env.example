# Copie este arquivo para .env e preencha com os dados do seu ambiente.
# Nunca coloque senha real, service_role_key ou chaves privadas no Git.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=preencha_com_a_chave_anonima
DATABASE_URL=postgresql://postgres:preencha_a_senha@127.0.0.1:54322/postgres
# Origens do front (Vite local; acrescente a URL da Vercel), separadas por virgula.
CORS_ORIGINS=http://localhost:5173
# Exige JWT do Supabase nos modulos antigos (admin, compras, estoques...). Sem valor, liga
# sozinha quando SUPABASE_URL esta definida; false so para rodar sem Supabase. Com true,
# SUPABASE_URL e obrigatoria.
# AUTENTICACAO_OBRIGATORIA=true

# Postgres LOCAL so para os testes de banco: banco dedicado com nome terminado em _teste.
# Os testes recriam o schema public dele. Nunca aponte para o Supabase.
TEST_DATABASE_URL=postgresql://postgres:preencha_a_senha@127.0.0.1:5432/lorenzi_teste
