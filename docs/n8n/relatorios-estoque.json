      "id": "e11ba985-04fa-4904-b010-1cbbd92ff7c9",
      "name": "Relatórios do dia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "retryOnFail": true,
